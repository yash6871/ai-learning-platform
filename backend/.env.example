# --- Database & Cache ---
# Default (Docker / Postgres):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/platform
# No Postgres available yet? Comment the line above and uncomment this one
# instead - no server needed, creates a local file ./platform.db:
# DATABASE_URL=sqlite:///./platform.db
REDIS_URL=redis://redis:6379/0

# --- JWT (shared secret/algorithm across the whole platform) ---
JWT_SECRET_KEY=change_this_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_EXPIRE_MINUTES=30

# --- Azure Blob Storage (optional in dev - uploads/emails are logged/stubbed if unset) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=platform-uploads
AZURE_STORAGE_CONTAINER_RECORDINGS=mock-interview-recordings
AZURE_STORAGE_CONTAINER_REPORTS=reports

# --- Gemini (AI features: chatbot, resume builder, question gen, interview analysis) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- AI provider switch for the AI Assistant (chatbot/resume/career guidance) ---
# "gemini" (default, needs GEMINI_API_KEY + billing on Google's side) or
# "groq" (genuinely free, no credit card - get a key at https://console.groq.com/keys)
AI_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Judge0 (coding lab code execution) ---
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# --- Email ---
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@platform.com

# --- SMS ---
SMS_PROVIDER_API_KEY=

# --- Misc ---
FACE_RECOGNITION_SERVICE_URL=
FRONTEND_URL=http://localhost:5173
ENV=development

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
